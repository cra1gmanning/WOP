{
  "name": "workout-planner",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "test": "node scripts/check-public.mjs --self-test && node scripts/check-public.mjs && vitest run",
    "check-public": "node scripts/check-public.mjs",
    "prepublish": "node scripts/check-public.mjs",
    "prepare": "node scripts/install-hooks.mjs",
    "lint": "tsc --noEmit",
    "generate": "tsx scripts/generate-library.ts",
    "preview": "vite preview --host 127.0.0.1 --port 4173",
    "icons": "python3 scripts/make-icons.py"
  },
  "dependencies": {
    "@azure/msal-browser": "^5.27.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "jsdom": "^30.1.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^5.0.5"
  }
}
